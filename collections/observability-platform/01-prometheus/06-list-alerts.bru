meta {
  name: 06 List Firing and Pending Alerts
  type: http
  seq: 6
}

get {
  url: {{prometheusUrl}}/api/v1/alerts
  body: none
  auth: none
}

tests {
  test("lists Prometheus evaluated alerts", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.alerts).to.be.an("array");
  });
}

docs {
  Retrieves active (`firing` / `pending`) Prometheus alert instances.
}
