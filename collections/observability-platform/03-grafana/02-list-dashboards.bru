meta {
  name: 02 Search Dashboards
  type: http
  seq: 2
}

get {
  url: {{grafanaUrl}}/api/search?type=dash-db&limit=25
  body: none
  auth: bearer
}

params:query {
  type: dash-db
  limit: 25
}

auth:bearer {
  token: {{grafanaToken}}
}

tests {
  test("searches provisioned Grafana dashboards", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Lists provisioned dashboards to verify GitOps dashboard ConfigMap / sidecar sync.
}
