meta {
  name: 03 List Datasources
  type: http
  seq: 3
}

get {
  url: {{grafanaUrl}}/api/datasources
  body: none
  auth: bearer
}

auth:bearer {
  token: {{grafanaToken}}
}

tests {
  test("lists configured Grafana datasources", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Verifies provisioned Prometheus, Loki, and Tempo datasources in Grafana.
}
