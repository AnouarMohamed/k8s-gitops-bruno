get {
  url: {{grafanaUrl}}/api/health
  body: none
  auth: none
}

tests {
  test("Grafana database and API report ok", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().database).to.equal("ok");
  });
}

docs {
  Checks Grafana `/api/health` endpoint and backing database status.
