meta {
  name: 02 List Active Alerts
  type: http
  seq: 2
}

get {
  url: {{alertmanagerUrl}}/api/v2/alerts?active=true&silenced=false
  body: none
  auth: none
}

params:query {
  active: true
  silenced: false
}

tests {
  test("lists unsilenced active alerts", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Lists active, unsilenced Alertmanager alerts currently routing to receivers.
}
