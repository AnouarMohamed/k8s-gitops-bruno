meta {
  name: 04 Trigger Application Sync
  type: http
  seq: 4
}

post {
  url: {{argocdUrl}}/api/v1/applications/{{appName}}/sync
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "revision": "{{targetRevision}}",
    "prune": true,
    "dryRun": false,
    "strategy": {
      "apply": {
        "force": false
      }
    },
    "syncOptions": {
      "items": [
        "CreateNamespace=true",
        "PruneLast=true"
      ]
    }
  }
}

tests {
  test("initiates application sync", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.have.property("operationState");
  });
}

docs {
  Triggers an immediate Argo CD sync for `{{appName}}` against `{{targetRevision}}`.
  Set `"dryRun": true` in the JSON payload to preview diff/validation without mutating cluster resources.
}
