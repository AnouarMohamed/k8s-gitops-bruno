meta {
  name: 04 API Resources Discovery
  type: http
  seq: 4
}

get {
  url: {{k8sApiUrl}}/apis
  body: none
  auth: inherit
}

tests {
  test("returns APIGroupList", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.kind).to.equal("APIGroupList");
    expect(body.groups).to.be.an("array");
  });
}

docs {
  Lists registered API groups (core extensions, apps, networking, CRDs).
}
