meta {
  name: 04 List Cert-Manager Certificates
  type: http
  seq: 4
}

get {
  url: {{k8sApiUrl}}/apis/cert-manager.io/v1/namespaces/{{namespace}}/certificates
  body: none
  auth: inherit
}

tests {
  test("lists cert-manager Certificates", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().kind).to.equal("CertificateList");
  });
}

docs {
  Lists `cert-manager.io/v1` Certificate objects in `{{namespace}}` to verify TLS issuance and renewal windows.
}
