meta {
  name: 03 List ServiceAccounts
  type: http
  seq: 3
}

get {
  url: {{k8sApiUrl}}/api/v1/namespaces/{{namespace}}/serviceaccounts
  body: none
  auth: inherit
}

tests {
  test("lists service accounts", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().kind).to.equal("ServiceAccountList");
  });
}

docs {
  Lists ServiceAccounts in `{{namespace}}`, useful for auditing IRSA/Workload Identity annotations and automount settings.
}
