meta {
  name: 05 List Kyverno PolicyReports
  type: http
  seq: 5
}

get {
  url: {{k8sApiUrl}}/apis/wgpolicyk8s.io/v1alpha2/namespaces/{{namespace}}/policyreports
  body: none
  auth: inherit
}

tests {
  test("retrieves wgpolicyk8s PolicyReports", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().kind).to.equal("PolicyReportList");
  });
}

docs {
  Fetches Kubernetes Policy Working Group (`wgpolicyk8s.io/v1alpha2`) PolicyReports generated by Kyverno
  to inspect admission or background scan pass/fail/warn summaries in `{{namespace}}`.
}
