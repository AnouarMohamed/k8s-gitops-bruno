meta {
  name: 04 List Deployments
  type: http
  seq: 4
}

get {
  url: {{k8sApiUrl}}/apis/apps/v1/namespaces/{{namespace}}/deployments
  body: none
  auth: inherit
}

tests {
  test("lists deployments in namespace", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.kind).to.equal("DeploymentList");
  });
}

docs {
  Lists all `apps/v1` Deployments in `{{namespace}}`, including replica status and rolling update strategy.
}
