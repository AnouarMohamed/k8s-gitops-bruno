meta {
  name: 03 List Project Webhook Policies
  type: http
  seq: 3
}

get {
  url: {{harborUrl}}/api/v2.0/projects/{{harborProject}}/webhook/policies
  body: none
  auth: inherit
}

tests {
  test("lists Harbor project webhook policies", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Lists webhook notification policies configured on `{{harborProject}}` (e.g., triggering Flux `Receiver` on `PUSH_ARTIFACT`).
}
