meta {
  name: 01 List Projects
  type: http
  seq: 1
}

get {
  url: {{harborUrl}}/api/v2.0/projects?page=1&page_size=25
  body: none
  auth: inherit
}

params:query {
  page: 1
  page_size: 25
}

tests {
  test("lists Harbor projects", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Lists Harbor projects with metadata including `auto_scan`, `severity`, and `prevent_vul` enforcement flags.
}
