meta {
  name: 01 List GitRepositories
  type: http
  seq: 1
}

get {
  url: {{k8sApiUrl}}/apis/source.toolkit.fluxcd.io/v1/namespaces/{{fluxNamespace}}/gitrepositories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{k8sToken}}
}

tests {
  test("lists Flux GitRepositories", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().kind).to.equal("GitRepositoryList");
  });
}

docs {
  Lists `source.toolkit.fluxcd.io/v1` GitRepository sources in `{{fluxNamespace}}`.
}
