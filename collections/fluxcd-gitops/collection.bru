headers {
  Accept: application/json
  User-Agent: bruno-fluxcd-gitops/1.0
}

docs {
  # Flux v2 GitOps Collection

  Covers Flux Notification Controller webhook receivers (with automatic HMAC-SHA256
  pre-request payload signing), direct Kubernetes API queries and reconcile annotations
  for Flux Source/Kustomize/Helm CRDs, and controller Prometheus metrics endpoints.
}
